# Copy to .env and fill in. Never commit real keys.

# --- AI ---
# Claude (Anthropic) writes the analysis of the paid report; without it a
# rule-based text is used. ANTHROPIC_MODEL is optional (default claude-sonnet-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: PDF upload of a DPE (/api/analyze-dpe)
OPENAI_API_KEY=

# --- Supabase (accounts) ---
SUPABASE_URL=https://xxxx.supabase.co
# Public key, sent to the browser (sb_publishable_... or legacy anon key)
SUPABASE_ANON_KEY=
# Secret: server only, bypasses row level security (sb_secret_... or legacy service_role key)
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy shared JWT secret (HS256)
SUPABASE_JWT_SECRET=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One-time price for a single report, recurring price for the Pro plan
STRIPE_PRICE_REPORT=price_...
STRIPE_PRICE_PRO=price_...
# Public URL of the app, used for Stripe redirects
PUBLIC_APP_URL=https://sprea.app
# "true" to compute VAT with Stripe Tax (requires a France registration in Stripe Tax)
STRIPE_AUTOMATIC_TAX=

# --- API protection ---
# Extra origins allowed to call the API (comma separated). Empty = same origin only.
ALLOWED_ORIGINS=
# Rate limits per client IP
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_SIMULATE_PER_MIN=120
RATE_LIMIT_AI_PER_HOUR=10

# --- DPE alerts (daily job, Vercel Cron) ---
# Random secret: Vercel sends it to /api/cron/alerts (Authorization: Bearer ...)
CRON_SECRET=
# Optional: morning email of the alerts, through Resend (resend.com). Without
# them the alerts are only shown on /alertes. Sender on a domain verified in Resend.
RESEND_API_KEY=
ALERTS_FROM=SPREA <alertes@votre-domaine.fr>
# Optional: email address notified of each quote request (Agence / Réseau), needs Resend
QUOTES_TO=
# Public site address used in canonical URLs, social previews and the sitemap
# (build time, scripts/seo/prerender.mjs). Set it when a custom domain is added.
PUBLIC_SITE_URL=https://sprea.app
