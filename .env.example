# Copy to .env and fill in. Never commit real keys.

# --- AI ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Supabase (accounts) ---
SUPABASE_URL=https://xxxx.supabase.co
# Public key, sent to the browser
SUPABASE_ANON_KEY=
# Secret: server only, bypasses row level security
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy shared JWT secret (HS256)
SUPABASE_JWT_SECRET=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One-time price for a single report, recurring price for the Pro plan
STRIPE_PRICE_REPORT=price_...
STRIPE_PRICE_PRO=price_...
# Public URL of the app, used for Stripe redirects
PUBLIC_APP_URL=https://your-app.vercel.app

# --- API protection ---
# Extra origins allowed to call the API (comma separated). Empty = same origin only.
ALLOWED_ORIGINS=
# Rate limits per client IP
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_SIMULATE_PER_MIN=120
RATE_LIMIT_AI_PER_HOUR=10
