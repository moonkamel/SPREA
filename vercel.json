{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "api/main.py"
        },
        {
            "source": "/demo",
            "destination": "/demo/index.html"
        },
        {
            "source": "/tarifs",
            "destination": "/tarifs/index.html"
        },
        {
            "source": "/observatoire",
            "destination": "/observatoire/index.html"
        },
        {
            "source": "/cgv",
            "destination": "/cgv/index.html"
        },
        {
            "source": "/mentions-legales",
            "destination": "/mentions-legales/index.html"
        },
        {
            "source": "/confidentialite",
            "destination": "/confidentialite/index.html"
        },
        {
            "source": "/observatoire/:slug",
            "destination": "/observatoire/:slug/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/app.html"
        }
    ],
    "functions": {
        "api/main.py": {
            "maxDuration": 300
        }
    },
    "crons": [
        {
            "path": "/api/cron/alerts",
            "schedule": "0 5 * * *"
        },
        {
            "path": "/api/cron/copro-docs",
            "schedule": "30 4 * * *"
        }
    ]
}
