{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "api/main.py"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "functions": {
        "api/main.py": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/alerts",
            "schedule": "0 5 * * *"
        }
    ]
}
